// ----------------------------------------------------
// Global Drum Aliases
// ----------------------------------------------------
$DRUM_GLITCH = cp stut(4, 0.5, 0.125)

// ----------------------------------------------------
// Global Harmonic Progressions & Phrases
// ----------------------------------------------------
// Group full phrases into single-sequence blocks
$PHRASE_A = [ 0_t 5_sus4 2_t 3_sus4 ]
$PHRASE_B = [ 0_t 3_sus2 4_t 4_7 ]
$PHRASE_C = [ -2_t 0_7 2_7 5_sus4 ]

// Alternates root movement predictably every cycle
$HOME_CHORD = < 0_t -2_t 2_t >

// Rolls the dice on how the phrase resolves
$TURNAROUND = [ 5_sus4 | 4_7 | 3_sus4 | 6_t ]

// ----------------------------------------------------
// Global Bass Roots
// ----------------------------------------------------
$B_TONIC   = [ 4: 0 | 2: 0 | 1: 2 ]
$B_SUBDOM  = [ 3 | 3 | 5 ]
$B_DOM     = [ 4 | 4 | 6 ]
$B_PASSING = [ -2 | 2 | 1 ]

$B_HOME = < 0 -2 2 >
$B_TURN = [ 5 | 4 | 3 | 6 ]

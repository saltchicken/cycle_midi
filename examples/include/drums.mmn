$KICK_1 = bd*2
$KICK_2 = bd*2 stut(2, 0.5, 0.33)

$SNARE_1 = sn(3,8)

$CLAP_1 = cp*2
$CLAP_2 = cp stut(4, 0.5, 0.125)

$TOM_1 = lt*2
$TOM_2 = [ . lt . lt*2 ] 


$DRUM_1 =
  {
    $KICK_1 |
    $SNARE_1
  }

$DRUM_2 = { $KICK_1 | $TOM_2 }

$DRUM_3 = seqPLoop{
    (0, 7): [ bd ch sn ch . ch sn bd ] |
    (7, 8): [ sn sn bd bd sn sn bd bd ]
}


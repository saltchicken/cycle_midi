$BASE = [ bd ch sn ch . ch sn bd ]
$FILL = [ sn sn bd bd sn sn bd bd ]

$DRUM_MAIN = seqPLoop{
    (0, 7): $BASE |
    (7, 8): $FILL
}

$DRUM_GLITCH = cp stut(4, 0.5, 0.125)
$DRUM_SNARE = sn(3,8)
$DRUM_KICK = { bd*2 | [ . lt . lt*2 ] }

$DRUM_1 = 
  {
    bd*2 |
    sn(3,8)
  }

$DRUM_2 = bd*2 stut(2, 0.5, 0.33)

$DRUM_3 = sn(3,8)
$DRUM_4 = bd*2

// ----------------------------------------------------
// Global Bass Roots
// ----------------------------------------------------
$B_TONIC   = [ 4: 0 | 2: 0 | 1: 2 ]
$B_SUBDOM  = [ 3 | 3 | 5 ]
$B_DOM     = [ 4 | 4 | 6 ]
$B_PASSING = [ -2 | 2 | 1 ]

$B_HOME = < 0 -2 2 >
$B_TURN = [ 5 | 4 | 3 | 6 ]

$B_PHRASE_A = [ 0 . 5*2 5 | 2 . . 3 ]
$B_PHRASE_B = [ 0 0 . 3 | 4 . 4*2 4 ]
$B_PHRASE_C = [ -2 . 0 . | 2 2 5 . ]

// Rolling 16th-note style bass patterns (phrygian thrives on the 0 to 1 relationship)
$BASS_A = [ 0*2 0 1*2 0 ]
$BASS_B = [ 3*2 1 0 0*2 ]
$BASS_C = [ 0 0 1 1 ]


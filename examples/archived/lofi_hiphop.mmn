// --- CYCLE MIDI: LOFI HIP-HOP ---
// Dusty, relaxed, and repetitive but constantly generating new subtle variations.

#BPM=85
#SCALE=G3 dorian
#QUANTIZE=AUTO

// T1: Jazzy Keys
// Locks the probability and random choice generator to a specific seed (42),
// meaning the "randomness" will repeat identically every bar like a sampled loop.
// However, `m_every 2` increments the seed every 2 macro-cycles, generating 
// a completely new loop variation every 2 bars!
T1 seed 42 m_every 2:
    [0+2+4+6 | -2+0+2+4] . [1+3+5+7 . . .]?70 .

// T2: Upright Bass
// Deep and sparse, mostly leaving space on the downbeats.
T2 down 2:
    { 0 . . -2 | . 3 . . }

// T10: Boom Bap Drums
// Laid back kick and snare. The hi-hats use a random choice pipe to 
// occasionally throw in a double-hit (ratchet) for groove.
T10: {
    36 . . [36 . . 36] |
    . . 38 . |
    [42 | 42*2] 42 [42 | 42*2]?80 42 
}

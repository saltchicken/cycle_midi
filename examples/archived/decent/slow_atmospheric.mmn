// --- CYCLE MIDI: SLOW ATMOSPHERIC ---
#BPM=75
#SCALE=E2 dorian
#QUANTIZE=AUTO

// T1: Evolving Ambient Drone
// Uses the 'slow' modifier to stretch out the chords.
// A slow sine wave LFO gently sweeps the filter cutoff (CC74) to create a breathing effect.
T1 slow 2: {
    < [0+2+4 _ _ _] [4+6+8 _ _ _] [-1+1+3 _ _ _] > |
    cc74@sine(30, 85, 0.125)
}

// T2: Sparse Melancholic Piano/Lead
// Shifted up one octave. Uses random choices and probability so it doesn't play every time.
// The alternator at the end provides a subtle shift in the phrase.
T2 up 1:
    [ 0 _ 2 . | 4 . . . | -1 _ _ . ]?75 < [7 .] [. .] >

// T3: Twinkling Background Arp
// Shifted up two octaves and plays twice as fast, but has a 60% chance of triggering.
// The 'pinkyupdown' arp style gives it a cascading, harp-like quality.
T3 up 2:
    < [0 2 4 7] [2 4 6 9] >*2 arp(pinkyupdown)?60

// T10: Deep, Distant Percussion
// Layer 1: A very deep, quiet kick that only hits every 2 cycles.
// Layer 2: A sparse, generative rimshot using Euclidean rhythms, playing softly.
// Layer 3: A distant cymbal/chime that only triggers on the 4th macro-cycle.
T10: {
    [36@60 . . .] only(2) |
    37(3,16)?50 |
    [. . . 49@40] m_only(4)
}

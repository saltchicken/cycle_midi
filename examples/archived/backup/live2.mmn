#BPM=128
#SCALE=G3 minor

#INCLUDE "include/drums.mmn"
#INCLUDE "include/bass.mmn"
#INCLUDE "include/progressions.mmn"
#INCLUDE "include/random.mmn"


T9 up 1 slow 16 seed 909 t_every 8:
  [ 
  $TONIC $SUBDOM $TONIC $DOM $TONIC $PASSING $SUBDOM $DOM |
  [ 4: $PHRASE_A | 2: $PHRASE_B | 1: $PHRASE_C ] |
  $HOME_CHORD  3_t  $HOME_CHORD  $TURNAROUND
  ]

// Added an arpeggiator to the pluck track
T1 slow 4 seed 303 t_every 4:
  [0@40 2@40 4@40 7@40] arp(down) if(2)

T2 down 1 slow 16 seed 303:
  [
  $B_TONIC . $B_TONIC $B_DOM $B_TONIC $B_PASSING . $B_DOM |
  [ 4: $B_PHRASE_A | 2: $B_PHRASE_B | 1: $B_PHRASE_C ] |
  $B_HOME 3*4 $B_HOME $B_TURN
  ]

// Dotted-eighth delay trail (0.375) on the lead line
T4 slow 4 seed 808 t_every 8:
  $RANDOM_INTERVAL*4 stut(3, 0.4, 0.375) if(3)

T10:
  { [4: $DRUM_1 | 2: $DRUM_4 | 1: $DRUM_2] | $DRUM_3 if(4) | [ _ lt*4 _ lt*8 ] if(16) }

#BPM=200
#SCALE=C4 major
#QUANTIZE=auto

#INCLUDE "include/drums.mmn"

$PRELUDE = 
chain {
  1: [10 7 5 4 5 7 3 5]
  1: [7 8# 8 7 8 5# 3 2]
  1: [3 5# 1 3 5 7 5# 5]
  1: [5# 4 2 1 2 4 0 2]
  1: [4 5# 5 4 5 4 3 2]
  1: [3 5 0 2 3 5 4 3]
  1: [5 7 7 7 7 7 7 7]
  1: [7 7 7 5 7 4 2 1]
  1: [2 4 0 2 4 5# 5 4]
  1: [8 6 8 8 8 8 8 8]
  1: [8 8 8 6 8 5 3 2]
  1: [3 5 1 3 5 7 5# 5]
  1: [5# 4 2 1 2 4 0 2]
  1: [4 5# 5 4 5 3 1 0#]
  1: [1 3 -2# 1 3 5 4 3]
  1: [4 2 0# -1 0# 2 -2 0#]
  1: [2 4 3 2 3 -9 5 -12]
  1: [8 -9 5 -11 3 -7 1 -9]
  1: [4 -9# 5# -11# 8 -9# 5# -10]
  1: [4 -6 1 -8 4 -9# 7# -11#]
  1: [9 -9# 7# -10 4 -5 2 -7#]
  1: [8 5 3 2 3 5 1 3]
  1: [5 7 5# 5 10 8 5# 5]
  1: [5# 8 3 5# 8 10 9 8]
  1: [12 10# 12 12 12 12 12 12]
  1: [12 12 12 10# 12 9 7# 6]
  1: [7# 9 5 7# 9 11 10# 9]
  1: [9 11 11 11 11 11 11 11]
  1: [11 11 11 9 11 8 6 5]
  1: [6 8 4 6 8 10 8# 8]
  1: [8# 7 5 4 5 7 3 5]
  1: [7 8# 8 7 8 5# 4 3#]
  1: [4 5# 1# 4 5# 8 7 5#]
  1: [7 5 3# 2 3# 5 1 3#]
  1: [5 7 5# 5 5 7 7 7]
  2: [7 7 7 7 7 7 7 7]
  1: [7 7 7 7 3 1 3 3]
  1: [3 3 3 3 3 3 3 3]
  1: [1 5 3 2 3 5 1 3]
  1: [5 7 5# 5 4 8 5# 5]
  1: [5# 8 4 5# 8 10 9 8]
  1: [9 11 9 8 9 11 7 9]
  1: [11 12# 12 11 14 12 10 9]
  1: [10 12 8 10 12 14 12# 12]
  1: [12# 11 9 8 9 11 7 9]
  1: [11 12# 12 11 12 10 7 5#]
  1: [7 10 5 7 8# 11 10 8#]
  1: [8# 8# 8# -9 -9# -6 -11 7]
  1: [5# 5 4 3 5# -7 11 -9]
  1: [9 -5 7 -9# 5# -3 11 -5]
  1: [5 4 3 2 3 5 1 3]
  1: [1 -2# -3 2 3 -2# -2 -3]
  1: [-2 0 -4 -7 -9 -7 -11 _]
}


T10:
  $DRUM_3


T1:
  $PRELUDE

T2 down 2:
  $PRELUDE chordify lowest ratchet(4)

T3 down 1:
  $PRELUDE chordify(-2, -1)

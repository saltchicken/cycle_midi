T10:
  $DRUM_3


T1:
  $PRELUDE

T2 down 2:
 $PRELUDE chordify lowest ratchet(4)

T3 down 1:
// Define your two effect states
$CHORD_A = $PRELUDE chordify(-2, -1)
$CHORD_B = $PRELUDE chordify(3, 1)

T3 down 1:
  // Route 3 cycles to A, and 5 cycles to B. 
  // It repeats this 8-step sequence infinitely while $PRELUDE progresses normally.
  < $CHORD_A $CHORD_A $CHORD_A $CHORD_B $CHORD_B $CHORD_B $CHORD_B $CHORD_B >

#BPM=124
#SCALE=F3 dorian

#INCLUDE "include/drums.mmn"
#INCLUDE "include/bass.mmn"
#INCLUDE "include/progressions.mmn"
#INCLUDE "include/random.mmn"

// T4 (Atmosphere) - Slow, evolving chords that float off the grid
// Uses strum() for a rolled attack and phase shifts (~>) to push it slightly late
T4 up 1 slow 8 seed 707 t_every 4:
  [ 4: $PHRASE_A | 2: $PHRASE_C | 1: $PHRASE_B ] strum(30.0) ~> 0.125

// T2 (Bass) - A deep, rolling 16th-note groove
// Alternates between the main tonic progression and a driving phrygian-style roll
T2 down 1 slow 16 seed 808:
  [
    < $B_TONIC $B_PASSING > . $B_TONIC $B_DOM |
    [ 3: $BASS_A | 1: $BASS_C ]*2
  ]

// T1 (Melody) - Generative polymetric arpeggios
// Maps a 5-against-8 Euclidean rhythm onto random lead notes with a dotted-eighth delay trail
T1 up 2 slow 4 seed 909 t_every 2:
  struct(E(5, 8), $LEAD_POOL) arp(diverge) stut(3, 0.6, 0.375) if(3)

// T10 (Drums) - 4-on-the-floor backbone with claps and macro drum fills
T10:
  {
    [ 4: $DRUM_MAIN | 1: $DRUM_MAIN*2 ] |
    $DRUM_SNARE if(2) |
    cp ~> 0.05 if(4, 3) |
    [ _ _ _ bd*8 ] if(16) // Heavy 32nd-note kick roll at the end of the phrase
  }

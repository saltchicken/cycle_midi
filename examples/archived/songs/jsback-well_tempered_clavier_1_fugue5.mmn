#BPM=120
#SCALE=C4 major

$MELODY = 
chain [
  1: [. . . . -6 -4# -4# -4#],
  1: [-1 _ _ -1 -2 _ _ -3],
  1: [-4# _ _ -3 -2 0# 0# 0#],
  1: [3# _ _ 3# 2 _ _ 1],
  1: [0# _ -5 -4# 3# _ _ 3#],
  1: [-1 _ -1 0# 2 1 2 0#],
  1: [-2 _ _ -4# 2 3# 3# 3#],
  1: [6 _ _ 6 5 _ _ 4],
  1: [3# _ _ 4# 6 7# 7# 7#],
  1: [10# _ _ 10# 9 _ _ 8],
  1: [7# _ 9 10# 12 5 5 12],
  1: [12 _ 8 9 11 4 4 11],
  1: [11 _ 9 8 10# -11# -11# 9],
  1: [8 _ _ 9 7# _ _ 7#],
  1: [7# _ -6 -5 7# 8 8 8],
  1: [11 _ _ 11 10# _ _ 9],
  1: [8 -6 -6 -6 13 12 13 11#],
  1: [11# 10# 11# 9 9 8 9 7#],
  1: [8 -7# -7# -7# 12 11 12 10#],
  1: [10# 9 10# 8 8 7 8 6],
  1: [6 -8 -8 -8 5 6 8 6],
  1: [5 _ _ 9 8 _ _ 7],
  1: [6 _ _ 7# 8 3# 3# 3#],
  1: [6 _ _ 6 7# _ _ 4],
  1: [8 -6 -6 5 8 9 11 9],
  1: [8 _ _ 13 12 _ _ 11],
  1: [10# _ _ 8 10# -1 -1 11],
  1: [11 _ _ 12 10# _ _ 0],
  1: [10# 10# _ _ 9 9 -10 -10],
  1: [5 _ _ -7 8 9 _ -9],
  1: [10# 6 _ -11# 7 6 _ 2],
  1: [7 4 _ -2 1# 4 3# 4],
  1: [3# 3# 4 4 4 11 -1 -3],
  1: [2 -4# -3 0# 0# -6 -5 -2],
  1: [-2 5 7# 7# 7# 10# -2 -4#],
  1: [1 -5 -4# -1 -1 -7# -6 -3],
  1: [-3 4 6 6 6 9 -3 -5],
  1: [0# -6 -5 -2 -2 -8 -7# -4#],
  1: [-4# 3# 5 5 5 8 2 0#],
  1: [8 8 -2 -4# 9 8 7# -1],
  1: [8 10# -3 -5 -6 13 12 13],
  1: [11 11 10# 11 9 9 8 9],
  1: [7# 7# _ _ 5 8 -3 3#],
  1: [8 8 -7# 4 9 6 8 7#],
  1: [8 8 _ -6 -4# 6 7# 9],
  1: [7# 6 -4# -6 -7# 5 6 8],
  1: [6 5 -5 -7# -8 4 5 7],
  1: [5 4 8 10# 8 7# 11 13],
  1: [11 10# _ 2 7# 8 _ 4],
  1: [9 10# _ -2 3# 4 _ 0],
  1: [5 6 _ 4 6 7# _ 5],
  1: [8 3# _ _ -3 3# 3# 2],
  1: [3# 2 _ _ _ _ _ _],
  1: [_ _ _ _ _ _ _ _],
  1: [_ _ . . . . . .]
]

T1:
  $MELODY

T2 octave -2:
  $MELODY.chordify.extract(lowest).ratchet(4)

$CHORD_A = $MELODY.chordify(-2, -1)
$CHORD_B = $MELODY.chordify(3, 1)

T3 octave -1:
  alt($CHORD_A $CHORD_A $CHORD_A $CHORD_B $CHORD_B $CHORD_B $CHORD_B $CHORD_B)

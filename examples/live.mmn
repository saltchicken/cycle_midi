#BPM=120
#SCALE=C4 major
#QUANTIZE=auto

#INCLUDE "include/drums.mmn"

$PRELUDE = 
chain {
  2: [0 2 4 6]
  2: [3 5 3 2]
}


T10:
  $DRUM_3


T1:
  $PRELUDE

T2 down 2:
chain {
  3: $PRELUDE chordify lowest ratchet(4)
  1: $PRELUDE chordify lowest(1, 1) ratchet(4)

}

T3 down 1:
chain {
  3: $PRELUDE chordify(-2, -1)
  5: $PRELUDE chordify(3, 1)
}

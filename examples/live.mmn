#BPM=120
#SCALE=E3 dorian

$RANDOM_INTERVAL = [ 4:0 | 1 | 2 | 3 | 2:4 | 4:5 | 6 | 7 | 8 ]
$DRUM_1 = 
  {
    bd*2 |
    sn(3,8)
  }

$DRUM_2 = bd*2 stut(4, 0.5, 0.125)


$TONIC   = [ 4: 0_t | 2: 0_7 | 1: 2_7 ]
$SUBDOM  = [ 3_t | 3_sus4 | 5_7 ]
$DOM     = [ 4_t | 4_7 | 6_t ]
$PASSING = [ -2_t | 2_sus4 | 1_7 ]

// Group full phrases into single-sequence blocks
$PHRASE_A = [ 0_t 5_sus4 2_t 3_sus4 ]
$PHRASE_B = [ 0_t 3_sus2 4_t 4_7 ]
$PHRASE_C = [ -2_t 0_7 2_7 5_sus4 ]

// Alternates root movement predictably every cycle
$HOME_CHORD = < 0_t -2_t 2_t >

// Rolls the dice on how the phrase resolves
$TURNAROUND = [ 5_sus4 | 4_7 | 3_sus4 | 6_t ]


// 1. Root Note Variables (Strips the muddy chord extensions)
$B_TONIC   = [ 4: 0 | 2: 0 | 1: 2 ]
$B_SUBDOM  = [ 3 | 3 | 5 ]
$B_DOM     = [ 4 | 4 | 6 ]
$B_PASSING = [ -2 | 2 | 1 ]

// 2. Groovy Bass Phrases (Adds rests '.' and 16th rhythms '*2')
$B_PHRASE_A = [ 0 . 5*2 5 | 2 . . 3 ]
$B_PHRASE_B = [ 0 0 . 3 | 4 . 4*2 4 ]
$B_PHRASE_C = [ -2 . 0 . | 2 2 5 . ]

$B_HOME = < 0 -2 2 >
$B_TURN = [ 5 | 4 | 3 | 6 ]

T9 up 1 slow 16 seed 808 t_every 8:
  [ 
  $TONIC $SUBDOM $TONIC $DOM $TONIC $PASSING $SUBDOM $DOM |
  [ 4: $PHRASE_A | 2: $PHRASE_B | 1: $PHRASE_C ] |
  $HOME_CHORD  3_t  $HOME_CHORD  $TURNAROUND
  ]

T1 up 2 slow 4 seed 420 t_every 4:
  [0@20 1@20 2@20 3@20] m_if(4)

T2 down 1 slow 16 seed 420:
  [
  $B_TONIC . $B_TONIC $B_DOM $B_TONIC $B_PASSING . $B_DOM |
  [ 4: $B_PHRASE_A | 2: $B_PHRASE_B | 1: $B_PHRASE_C ] |
  $B_HOME 3*2 $B_HOME $B_TURN
  ]

T10:
  { $DRUM_2 | $DRUM_1 if(4) | [ _ _ lt*3] if(16) }

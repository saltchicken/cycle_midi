#BPM=120
#SCALE=C4 major


$PRELUDE = chain [
  2: [0 2 4 7 9 4 7 9],
  2: [0 1 5 8 10 5 8 10],
  2: [-1 1 4 8 10 4 8 10],
  2: [0 2 4 7 9 4 7 9],
  2: [0 2 5 9 12 5 9 12],
  2: [0 1 3# 5 8 3# 5 8],
  2: [-1 1 4 8 11 4 8 11],
  2: [-1 0 2 4 7 2 4 7],
  2: [-2 0 2 4 7 2 4 7],
  1: [-6 -2 1 3# 7 1 3# 7],
  1: [_ -6 1 3# 7 1 3# 7],
  2: [_ -3 1 4 6 1 4 6],
  2: [_ -3 2 4 7# 2 4 7#],
  2: [_ -4 1 5 8 1 5 8],
  2: [_ -4 1 3 6 1 3 6],
  2: [_ -5 0 4 7 0 4 7],
  2: [_ -5 -2 0 3 -2 0 3],
  2: [_ -6 -2 0 3 -2 0 3],
  2: [_ -10 -3 -1 3 -3 -1 3],
  2: [_ -7 -3 0 2 -3 0 2],
  2: [_ -7 -2# 0 2 -2# 0 2],
  1: [_ -11 -2 0 2 -2 0 2],
  1: [_ _ -2 0 2 -2 0 2],
  2: [_ _ -2 0 1# -2 0 1#],
  2: [_ _ -1 0 1 -1 0 1],
  2: [_ _ -3 -1 1 -3 -1 1],
  2: [_ _ -3 0 2 -3 0 2],
  2: [_ _ -3 0 3 -3 0 3],
  2: [_ _ -3 -1 3 -3 -1 3],
  2: [_ _ -2 0 3# -2 0 3#],
  2: [_ _ -3 0 4 -3 0 4],
  2: [_ _ -3 0 3 -3 0 3],
  2: [_ _ -3 -1 3 -3 -1 3],
  2: [_ _ -3 -2# 2 -3 -2# 2],
  1: [_ _ -4 -2 0 3 0 -2],
  1: [0 -2 -4 -2 -4 -6 -4 -6],
  1: [_ _ 4 6 8 10 8 6],
  1: [8 6 4 6 1 3 2 1],
  1: [2 _ _ -14 _ _ _ _],
  1: [_ _ _ _ _ _ _ _],
  1: [_ _ _ . . . . .]
]



T1:
  $PRELUDE

T2 down 2:
 $PRELUDE chordify lowest ratchet(4)

T3 down 1:
// Define your two effect states
$CHORD_A = $PRELUDE chordify(-2, -1)
$CHORD_B = $PRELUDE chordify(3, 1)

T3 down 1:
  // Route 3 cycles to A, and 5 cycles to B. 
  // It repeats this 8-step sequence infinitely while $PRELUDE progresses normally.
  < $CHORD_A $CHORD_A $CHORD_A $CHORD_B $CHORD_B $CHORD_B $CHORD_B $CHORD_B >

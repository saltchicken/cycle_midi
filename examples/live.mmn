#INCLUDE "include/drums.mmn"
#INCLUDE "include/progressions.mmn"
#INCLUDE "include/bass.mmn"

let MELODY = 
chain [
  1: [0# 1# 2 3# 4# . 7# .],
  1: [6 . 4# . [5# 6 5#] _ _ .],
  1: [6 . 4# 5# 6 . 5# 3#],
  1: [1# . 2 . [1# 2 1#] _ _ .],
  1: [0# 1# 2 3# 2 _ 1# 2],
  1: [3# _ 2 1# 0# _ _ .],
  1: [3# _ 2 1# 0# _ 1# 2],
  1: [3# _ 2 3# 4# _ _ .]
]

T1:
  MELODY

T2(octave: -1, seed: 44 every 2):
  RAND_CHORDIFY(MELODY)

T3(octave: -2):
  B_ROLL_16(MELODY)

T10:
  GROOVE_HOUSE

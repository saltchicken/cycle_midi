#BPM=110
#SCALE=C4 major
#QUANTIZE=1

// --- T1: The Driving Bass ---
// Steady 16th notes using ratchets to keep the energy high
T2(octave: 0) with .v(127) .g(10):
  [ 4 3 1 0 . . . . . . . . . . . .] / 2

// --- T2: Sparkling Synth Arp ---
// Diatonic 7th chords arpeggiated upwards and downwards
!T2(octave: 0) with .v(70) .g(40):
  chain [
    2: 0'7,
    1: -1'7,
    1: -2'7
  ].arp(updown) / 2

// --- T3: The Soaring Retrowave Lead ---
// High gate value triggers legato/portamento glides on your synth.
// The phrase ends with a fast ratchet run and a stuttering echo.
!T2(octave: 1) with .v(90) .g(95):
  chain [
    // Bar 1: The establishing motif
    1: [ 0 _ _ 2   4 _ 2 0   4 _ _ _   _ . . . ],
    // Bar 2: The tension builder
    1: [ 0 _ _ 2   4 _ 5 4   2 _ _ _   _ . . . ],
    // Bar 3: The emotional lift
    1: [ 4 _ _ 5   7 _ 8 7   5 _ _ _   _ . . . ],
    // Bar 4: The cascading turnaround into a delay tail
    1: [ 7 _ 5 _   4*2 2*2 0*2 -1*2  -2.stut(4, 0.7, 0.375) _ _ _ ]
  ] / 4

#BPM=80
//#SCALE=C4 major
#SCALE_SEQ={ (0, 4): C4 major | (4, 8): G3 major | (8, 12): F3 major }

#INCLUDE "include/drums.mmn"
#INCLUDE "include/progressions.mmn"
#INCLUDE "include/bass.mmn"

$MELODY = 
chain [
  4: [-3# 0# 2 _ -3# 0# 2 _],
]

T1:
  $MELODY

T2 octave -1 seed 44 every 2:
  $RAND_TEXTURE($MELODY)

T3 octave -2:
  $B_STUTTER($MELODY)

T10:
  $GROOVE_HOUSE

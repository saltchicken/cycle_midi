// --- CYCLE MIDI: ACID TECHNO ---
// Driving 4/4 beats and a squelchy 303-style bassline.

#BPM=135
#SCALE=E2 minor
#QUANTIZE=4

// T1: Acid Bassline
// Classic 16th note pattern using short gates (%) and holds (_) for slides/ties.
// The filter (CC 74) opens and closes rhythmically using a Saw LFO.
// The alternator < > changes the tail end of the riff every bar.
T1: {
    [0 0 7 _] [0%50 3%50 0 -1_] [0 12_ _ 0] <[3_ _ 0 0] [5_ _ 7 0]> |
    cc74@saw(20, 127, 0.5)
}

// T10: Techno Drum Machine
// Layer 1: Pounding 4-on-the-floor Kick
// Layer 2: Off-beat open hi-hats
// Layer 3: Syncopated snare/clap using a Euclidean rhythm (3 hits over 8 steps)
// Layer 4: A massive crash cymbal (49) that ONLY fires on the very first 
//          beat of every 4th macro-cycle.
T10: {
    36 36 36 36 |
    . 46 . 46 |
    39(3,8) 39(3,8) |
    [49 . . .] m_only(4)
}

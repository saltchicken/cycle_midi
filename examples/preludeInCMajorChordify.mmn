#BPM=80
#SCALE=C4 major
#QUANTIZE=auto

#INCLUDE "include/drums.mmn"

// 1. Wrap the entire melody in an alias so we can reuse it
$PRELUDE = chain {
  2: [7 1# 1 1# 0 1# 1 1#]
  2: [4# 3 2 3 0 3 2 3]
  2: [6 3 1# 3 1 3 1# 3]
  2: [7 4 3 4 1# 4 3 4]
  2: [8# 4# 4 4# 1# 4# 4 4#]
  2: [8 3# 2 3# 1 3# 2 3#]
  2: [8 4 3# 4 1 4 3# 4]
  2: [7 2 1 2 0 2 1 2]
  2: [7 3 2 3 0 3 2 3]
  2: [5# 3 1# 3 1 3 1# 3]
  2: [5# 4 3 4 1# 4 3 4]
  2: [4# 4 3 4 1# 4 3 4]
  2: [4# 1 0 1 -2# 1 0 1]
  2: [4 -2# -3# -2# 1# -2# -3# -2#]
  2: [3 0 -2# 0 -2 0 -2# 0]
  4: [3 1 0 1 -1 1 0 1]
  2: [1# 0 -1 0 -3 0 -1 0]
  2: [-4 1# 1 1# 3 1# 1 1#]
  2: [-4# 0 -1 0 1# 0 -1 0]
  2: [1# 0 -1 0 -3 0 -1 0]
  2: [3# 0 -1 0 -2 0 -1 0]
  2: [4 0 -1 0 1 0 -1 0]
  2: [4# 0 -1 0 1 0 -1 0]
  1: [-10 -8 -6 -4 -3# -4 -5 -4]
  1: [-1 -4 1 -1 -3# -4 -5 -4]
  1: [-10 -7 -6# -3 0 -3 -4# -3]
  1: [1# 0 4 1# 0 -3# -3 -3#]
  1: [-10 -9 -4# 0 1# 0 -1 0]
  1: [3# 0 5 3# 1# 0 -1 0]
  1: [-10 8 7 8 8# 7 6 7]
  1: [5 7 6 7 8 6 5 6]
  1: [4 6 5 6 7 5 4 5]
  1: [3# 5 4 5 6 4 3# 4]
  1: [1 11 10 11 11# 10 8# 10]
  1: [8 10 8# 10 11 8# 8 8#]
  1: [7 8# 8 8# 10 8 7 8]
  1: [6 8 7 8 8# 7 5# 7]
  1: [4 7 6 7 4# 10 8# 10]
  1: [4 8# 8 8# 3 8 7 8]
  1: [1# 7 6 7 4# 3 1# 3]
  1: [4 1# 1 1# 3 1 0 1]
  1: [2 _ 0 1 3 7 3 4]
  1: [3 _ 4 3 3 4# 3 3]
  1: [-1 -14 -8 -6 -4 -3# -3 -4]
  1: [-1 -4 1 -4 -1 -3# -3 -4]
  1: [-5 0# -2# -3 0 -3# -4 -3#]
  1: [-3 -2# -3 -5 -3# -4 -6 -4]
  1: [-5 -3 -5 -7 -4 -6 -8 -6]
  1: [-14 -10 -7 -6 -5 -3 -2# -3]
  1: [-3# 0 3 1 3 4# 7 6]
  1: [7 4 3 1 2 _ _ _]
  1: [_ _ _ _ _ _ _ _]
  1: [. . . . . . . .]
}


T10:
  $DRUM_3


T1:
  $PRELUDE

T2 down 2:
  $PRELUDE chordify lowest ratchet(4)

T3 down 1:
  $PRELUDE chordify(-2, -1)

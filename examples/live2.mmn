#BPM=128
#SCALE=G3 minor

$RANDOM_INTERVAL = [ 4:0 | 1 | 2 | 3 | 2:4 | 4:7 | 5 | 7 | -2 ]

// Four-on-the-floor kick paired with off-beat open hats
$DRUM_1 = { bd*2 | lt*2 shift(0.5) }

// Snare/Clap hits with a rhythmic 16th-note stut roll
$DRUM_2 = cp stut(3, 0.5, 0.25)
$DRUM_3 = sn(5,8)
$DRUM_4 = bd*2

// Driving, minor-focused chord palette
$TONIC   = [ 4: 0_t | 2: 0_sus2 | 1: 2_t ]
$SUBDOM  = [ 3_t | 3_sus4 | 5_7 ]
$DOM     = [ 4_t | 4_7 | 6_t ]
$PASSING = [ -2_t | 2_sus2 | 1_7 ]

// Syncopated sequence blocks
$PHRASE_A = [ 0_t 5_sus4 2_t 3_sus4 ]
$PHRASE_B = [ 0_t 3_sus2 4_t 4_7 ]
$PHRASE_C = [ -2_t 0_7 2_7 5_sus4 ]

$HOME_CHORD = < 0_t -2_t 2_t >
$TURNAROUND = [ 5_sus4 | 4_7 | 3_sus4 | 6_t ]

// 1. Root Note Variables
$B_TONIC   = [ 4: 0 | 2: 0 | 1: 2 ]
$B_SUBDOM  = [ 3 | 3 | 5 ]
$B_DOM     = [ 4 | 4 | 6 ]
$B_PASSING = [ -2 | 2 | 1 ]

// 2. Busier 16th-note bass phrases for a higher-energy groove
$B_PHRASE_A = [ 0 0*2 5 5*2 | 2 . . 3*2 ]
$B_PHRASE_B = [ 0 . 0 3 | 4 4*2 . 4 ]
$B_PHRASE_C = [ -2 -2*2 0 . | 2 . 5 5*2 ]

$B_HOME = < 0 -2 2 >
$B_TURN = [ 5 | 4 | 3 | 6 ]

T9 up 1 slow 16 seed 909 t_every 8:
  [ 
  $TONIC $SUBDOM $TONIC $DOM $TONIC $PASSING $SUBDOM $DOM |
  [ 4: $PHRASE_A | 2: $PHRASE_B | 1: $PHRASE_C ] |
  $HOME_CHORD  3_t  $HOME_CHORD  $TURNAROUND
  ]

// Added an arpeggiator to the pluck track
T1 slow 4 seed 303 t_every 4:
  [0@40 2@40 4@40 7@40] arp(down) if(2)

T2 down 1 slow 16 seed 303:
  [
  $B_TONIC . $B_TONIC $B_DOM $B_TONIC $B_PASSING . $B_DOM |
  [ 4: $B_PHRASE_A | 2: $B_PHRASE_B | 1: $B_PHRASE_C ] |
  $B_HOME 3*4 $B_HOME $B_TURN
  ]

// Dotted-eighth delay trail (0.375) on the lead line
T4 slow 4 seed 808 t_every 8:
  $RANDOM_INTERVAL*4 stut(3, 0.4, 0.375) if(3)

T10:
  { [4: $DRUM_1 | 2: $DRUM_4 | 1: $DRUM_2] | $DRUM_3 if(4) | [ _ lt*4 _ lt*8 ] if(16) }

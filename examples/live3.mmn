#BPM=132
#SCALE=A2 phrygian

// --- Drum Aliases ---
// A relentless kick paired with a low tom groove to replace hi-hats
$DRUM_MAIN = { bd*2 | [ . lt . lt*2 ] }

// A syncopated snare that occasionally glitches out with a tight stut
$DRUM_SNARE = sn(3,8)
$DRUM_GLITCH = cp stut(4, 0.5, 0.125)

// --- Harmonic Aliases ---
// Hypnotic, slow-moving phrygian chord progressions
$PAD_A = [ 0_t . 1_t . ]
$PAD_B = [ 3_t 1_t 0_sus2 . ]
$PAD_C = [ 4_t . -1_t . ]

// Rolling 16th-note style bass patterns (phrygian thrives on the 0 to 1 relationship)
$BASS_A = [ 0*2 0 1*2 0 ]
$BASS_B = [ 3*2 1 0 0*2 ]
$BASS_C = [ 0 0 1 1 ]

// A pool of intervals for the lead line to randomly pull from
$LEAD_POOL = [ 4: 0 | 3: 3 | 2: 4 | 1: 7 | 1: 8 | 2: 1 ]

// --- Tracks ---

// T9 (Pads) - Slow, evolving atmosphere
T9 up 1 slow 8 seed 111 t_every 4:
  [
    2: $PAD_A | 2: $PAD_B | 1: $PAD_C
  ]

// T2 (Bass) - Relentless driving groove (*2 doubles the speed to 16ths)
T2 down 1 slow 4 seed 222:
  [
    3: $BASS_A | 2: $BASS_B | 1: $BASS_C
  ]*2

// T1 (Arp) - Classic ascending/descending acid-style runs
!T1 up 2 slow 2 seed 333 t_every 2:
  [ 0 1 3 4 ] arp(updown) if(7)

// T4 (Lead) - Hypnotic lead with a heavy, dotted-eighth delay trail
T4 up 3 slow 2 seed 444 t_every 4:
  $LEAD_POOL*4 stut(3, 0.6, 0.75) if(2)

// T10 (Drums) - The backbone
T10:
  {
    [ 6: $DRUM_MAIN | 1: $DRUM_MAIN*2 ] |
    $DRUM_SNARE if(2) |
    $DRUM_GLITCH if(8) |
    [ _ _ bd*4 ] if(16) // Massive kick roll at the end of the 16-cycle phrase
  }
